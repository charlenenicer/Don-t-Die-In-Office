# Alebex API credentials (optional - game runs in demo mode without these)
ALEBEX_API_KEY=wt_your_api_key_here
ALEBEX_API_URL=https://api.alebex.ai/api/v1
ALEBEX_ENGINE_URL=https://api.voice.alebex.ai

# Webhooks and tools (required if using voice mode)
ALEBEX_WEBHOOK_SECRET=whsec_your_webhook_secret_here
TOOL_SHARED_SECRET=your_tool_secret_here

# Public base URL for tool callbacks (use Tailscale Funnel or similar tunnel)
PUBLIC_BASE_URL=

# Server port
PORT=3456
