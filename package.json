{
  "name": "open-plan",
  "version": "1.0.0",
  "description": "A 3D office-politics survival game with voice AI",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "setup-agents": "tsx --env-file-if-exists=.env scripts/setup-agents.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/supertest": "^6.0.2",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  }
}
